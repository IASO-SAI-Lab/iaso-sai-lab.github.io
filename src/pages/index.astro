---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import LabEmblem from "../components/LabEmblem.astro";
import TagList from "../components/TagList.astro";
import VisualPlaceholder from "../components/VisualPlaceholder.astro";
import { lab } from "../config/lab";
import { formatDate, sortByDate, sortByOrder } from "../lib/content";

const research = sortByOrder(await getCollection("research"));
const news = sortByDate(await getCollection("news")).slice(0, 3);
const papers = (await getCollection("papers"))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
const prototypes = sortByOrder(await getCollection("prototypes"))
  .filter((entry) => entry.data.featured)
  .slice(0, 3);
const now = new Date();
const events = (await getCollection("events"))
  .filter((entry) => entry.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
const featuredResearch =
  research.find((entry) => entry.data.featured) ?? research[0];
const remainingResearch = research.filter(
  (entry) => entry.id !== featuredResearch?.id
);
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-copy">
      <h1>Intelligence for dependable healthcare.</h1>
      <p class="hero-lede">{lab.description}</p>
      <div class="hero-actions">
        <a class="button" href="/research/">Explore research</a>
        <a class="button button-secondary" href={`mailto:${lab.email}`}>Contact the lab</a>
      </div>
    </div>
    <LabEmblem />
  </section>

  <section class="home-section page-shell" aria-labelledby="research-heading">
    <SectionHeader
      id="research-heading"
      title="Research areas"
      description="Questions are organised by the systems, evidence, and people they connect."
      href="/research/"
      linkLabel="All research"
    />
    {
      featuredResearch && (
        <div class="research-index">
          <article class="research-feature">
            <h3>
              <a href={`/research/${featuredResearch.id}/`}>
                {featuredResearch.data.title}
              </a>
            </h3>
            <p>{featuredResearch.data.description}</p>
            <TagList items={featuredResearch.data.keywords} />
            <a class="text-link" href={`/research/${featuredResearch.id}/`}>
              Read this area <span aria-hidden="true">→</span>
            </a>
          </article>
          <ul class="research-list">
            {remainingResearch.map((entry) => (
              <li>
                <a href={`/research/${entry.id}/`}>
                  <strong>{entry.data.title}</strong>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="home-section page-shell" aria-labelledby="news-heading">
    <SectionHeader
      id="news-heading"
      title="Latest news"
      description="A compact record of publications, events, software, and lab activity."
      href="/news/"
      linkLabel="News archive"
    />
    <ol class="news-rail">
      {
        news.map((entry) => (
          <li>
            <a href={`/news/${entry.id}/`}>
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              <strong>{entry.data.title}</strong>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-section page-shell" aria-labelledby="papers-heading">
    <SectionHeader
      id="papers-heading"
      title="Recent papers"
      description="Browse the archive by year, topic, type, author, venue, or keyword."
      href="/papers/"
      linkLabel="Publication archive"
    />
    <ol class="publication-list">
      {
        papers.map((entry) => (
          <li class="publication-item">
            <p class="publication-meta">
              {entry.data.year} · {entry.data.publicationType.replace("-", " ")}
            </p>
            <div>
              <h3>
                <a href={`/papers/${entry.id}/`}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.authors.join(", ")}. {entry.data.venue}.</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-section page-shell" aria-labelledby="prototypes-heading">
    <SectionHeader
      id="prototypes-heading"
      title="Featured prototypes"
      description="Software, demonstrators, and research artefacts tied back to questions and papers."
      href="/prototypes/"
      linkLabel="All prototypes"
    />
    <div class="prototype-grid">
      {
        prototypes.map((entry, index) => (
          <article class="prototype-card">
            <VisualPlaceholder
              label={entry.data.title}
              variant={entry.data.figure ?? (index === 0 ? "signal" : "pipeline")}
              src={entry.data.image}
              alt={entry.data.imageAlt}
            />
            <div>
              <p class="entry-meta">
                {entry.data.category.replace("-", " ")} · {entry.data.status}
              </p>
              <h3>
                <a href={`/prototypes/${entry.id}/`}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-section page-shell" aria-labelledby="events-heading">
    <SectionHeader
      id="events-heading"
      title="Upcoming events"
      description="Seminars, workshops, invited talks, and doctoral activity."
      href="/events/"
      linkLabel="All events"
    />
    {
      events.length > 0 ? (
        <ol class="event-list">
          {events.map((entry) => (
            <li>
              <a href={`/events/${entry.id}/`}>
                <time datetime={entry.data.date.toISOString()}>
                  {formatDate(entry.data.date)}
                </time>
                <strong>{entry.data.title}</strong>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p>No upcoming events are listed. Add an event Markdown file to publish one.</p>
      )
    }
  </section>
</BaseLayout>
