---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { sampleNotice } from "../../config/lab";
import { formatDate, titleCase } from "../../lib/content";

const now = new Date();
const allEvents = (await getCollection("events")).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);
const upcoming = allEvents.filter((entry) => entry.data.date >= now);
const past = allEvents
  .filter((entry) => entry.data.date < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Events"
  description="Upcoming and past seminars, workshops, conferences, invited talks, tutorials, and doctoral events."
>
  <PageHeader
    title="Events"
    description="A chronological record of public seminars, working sessions, talks, and doctoral activity."
    note={sampleNotice}
  />

  <section class="content-section page-shell" aria-labelledby="upcoming-events">
    <header class="section-header">
      <div>
        <h2 id="upcoming-events">Upcoming</h2>
        <p>Dates are shown in the event record’s configured time zone.</p>
      </div>
    </header>
    {
      upcoming.length > 0 ? (
        <ol class="event-list">
          {upcoming.map((entry) => (
            <li>
              <a href={`/events/${entry.id}/`}>
                <time datetime={entry.data.date.toISOString()}>
                  {formatDate(entry.data.date)}
                </time>
                <strong>{entry.data.title}</strong>
                <span>{titleCase(entry.data.eventType)}</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p>No upcoming events are listed. Add an event Markdown file to publish one.</p>
      )
    }
  </section>

  <section class="content-section page-shell" aria-labelledby="past-events">
    <header class="section-header">
      <div>
        <h2 id="past-events">Past</h2>
        <p>Materials remain attached to an event record when available.</p>
      </div>
    </header>
    <ol class="event-list">
      {
        past.map((entry) => (
          <li>
            <a href={`/events/${entry.id}/`}>
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              <strong>{entry.data.title}</strong>
              <span>{titleCase(entry.data.eventType)}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
